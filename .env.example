# GEMINI_API_KEY: Required for Gemini AI API calls.
# For local development, copy this file to .env and replace the placeholder
# with an API key from https://aistudio.google.com/apikey.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Prune gateway. When set, all AI requests use Prune instead of Gemini.
# Create this at https://app.withprune.com under Connect > API Keys.
# Store the provider key in Prune's vault; do not put it in this file.
PRUNE_API_KEY=""
PRUNE_GEMINI_URL="https://api.withprune.com/v1/proxy/gemini/generateContent"
PRUNE_MODEL="gemini-3.5-flash-lite"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"


